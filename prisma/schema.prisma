// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(100)
  name     String @db.VarChar(100)
  password String @db.VarChar(100)

  @@map("users")
}

model SparePart {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar(100)
  part_number      String       @unique @db.VarChar(100)
  minimum_quantity Int
  balance          Int
  specification    String       @db.VarChar(100)
  Department       Department?  @relation(fields: [department_id], references: [id], onDelete: SetNull)
  department_id    Int?
  MachineArea      MachineArea? @relation(fields: [machine_area_id], references: [id], onDelete: SetNull)
  machine_area_id  Int?
  Rack             Rack?        @relation(fields: [rack_id], references: [id], onDelete: SetNull)
  rack_id          Int?
  Kanban           Kanban[]

  created_at DateTime @default(now()) // otomatis terisi saat create
  updated_at DateTime @updatedAt

  @@map("spare_parts")
}

model Department {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(100)
  name        String      @db.VarChar(100)
  number      String      @db.VarChar(100)
  spare_parts SparePart[]

  created_at DateTime @default(now()) // otomatis terisi saat create
  updated_at DateTime @updatedAt

  @@map("departmens")
}

model MachineArea {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(100)
  name        String      @db.VarChar(100)
  spare_parts SparePart[]

  created_at DateTime @default(now()) // otomatis terisi saat create
  updated_at DateTime @updatedAt

  @@map("machine_areas")
}

model Operator {
  id   Int    @id @default(autoincrement())
  nik  String @unique @db.VarChar(100)
  name String @db.VarChar(100)

  created_at DateTime @default(now()) // otomatis terisi saat create
  updated_at DateTime @updatedAt

  @@map("operators")
}

model Rack {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(100)
  name        String      @db.VarChar(100)
  spare_parts SparePart[]
  kanbans     Kanban[]

  created_at DateTime @default(now()) // otomatis terisi saat create
  updated_at DateTime @updatedAt

  @@map("racks")
}

model Supplier {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  created_at DateTime @default(now()) // otomatis terisi saat create
  updated_at DateTime @updatedAt

  kanbans Kanban[]

  @@map("suppliers")
}

model Maker {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  created_at DateTime @default(now()) // otomatis terisi saat create
  updated_at DateTime @updatedAt

  kanbans Kanban[]

  @@map("makers")
}

model Kanban {
  id        Int    @id @default(autoincrement())
  js_code   String @unique @db.VarChar(100)
  quantity  Int
  lead_time Int

  spare_part    SparePart? @relation(fields: [spare_part_id], references: [id], onDelete: SetNull)
  spare_part_id Int?
  supplier      Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId    Int?
  maker         Maker?     @relation(fields: [makerId], references: [id], onDelete: SetNull)
  makerId       Int?
  rack          Rack?      @relation(fields: [rackId], references: [id], onDelete: SetNull)
  rackId        Int?

  created_at DateTime @default(now()) // otomatis terisi saat create
  updated_at DateTime @updatedAt

  @@map("kanbans")
}
